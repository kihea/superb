{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync-content": "node scripts/sync-content.mjs",
    "sync-tokens": "node scripts/tokens-to-css.mjs",
    "build-wasm": "node scripts/build-wasm.mjs",
    "ci:prepare": "npm run sync-content && npm run sync-tokens && npm run build-wasm",
    "ci:typecheck": "tsc -b",
    "ci:test:unit": "vitest run",
    "ci:build": "tsc -b && vite build",
    "check-theme-tokens": "node scripts/check-theme-tokens.mjs",
    "predev": "npm run sync-content && npm run sync-tokens && npm run build-wasm",
    "dev": "vite",
    "prebuild": "npm run sync-content && npm run sync-tokens && npm run build-wasm",
    "build": "tsc -b && vite build",
    "pretypecheck": "npm run sync-tokens && npm run build-wasm",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "pretest:unit": "npm run build-wasm",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "thinking-orbs": "^0.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.0.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
